{
  "name": "station-adapter-postgres",
  "version": "2.2.0",
  "description": "PostgreSQL adapter for station-signal and station-broadcast",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "import": "./dist/broadcast.js",
      "default": "./dist/broadcast.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "import": "./dist/schedules.js",
      "default": "./dist/schedules.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./beacon": {
      "types": "./dist/beacon.d.ts",
      "import": "./dist/beacon.js",
      "default": "./dist/beacon.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js",
      "default": "./dist/network.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "station-signal": "workspace:*",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "station-signal": "workspace:*",
    "station-broadcast": "workspace:*",
    "station-schedules": "workspace:*",
    "station-beacon": "workspace:*",
    "station-env": "workspace:*",
    "station-network": "workspace:*"
  },
  "peerDependenciesMeta": {
    "station-schedules": {
      "optional": true
    },
    "station-beacon": {
      "optional": true
    },
    "station-env": {
      "optional": true
    },
    "station-network": {
      "optional": true
    }
  }
}
